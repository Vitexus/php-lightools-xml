#!/usr/bin/make -f
PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/~.*//')
PKG_SOURCE  := $(shell jq -r '.name' composer.json)

%:
	dh $@

override_dh_install:
	mkdir -p debian/php-lightools-xml/usr/share/php/Lightools/Xml
	cp -r src/Xml/. debian/php-lightools-xml/usr/share/php/Lightools/Xml/
	install -m 644 debian/autoload.php debian/php-lightools-xml/usr/share/php/Lightools/Xml/autoload.php
	sed -i "s|'unknown'|'$(PKG_SOURCE)'|" debian/php-lightools-xml/usr/share/php/Lightools/Xml/autoload.php
	sed -i "s|'0.0.0'|'$(PKG_VERSION)'|" debian/php-lightools-xml/usr/share/php/Lightools/Xml/autoload.php
